# LTP Node A - Engine ID 1
# ionserialcla handles both TX and RX on the serial port
# udplsi is a dummy LSI (ionserialcla feeds segments directly via ltpHandleInboundSegment)
#
# span: engine maxExportSess maxImportSess maxSegSize aggSizeLimit aggTimeLimit 'LSO'
# - maxSegSize 128: fits within AX.25 256-byte info field limit
# - aggSizeLimit 512: small blocks = fewer segments per block = faster completion
# - aggTimeLimit 2: wait up to 2s to aggregate before sending
1 128
a span 2 128 128 128 512 2 'ionserialcla DEVICE:9600 G4DPZ-1 G4DPZ-2 2'
s 'udplsi 0.0.0.0:1113'
